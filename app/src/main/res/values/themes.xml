<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NavettePhoenix" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/phoenix_orange</item>
        <item name="colorPrimaryVariant">@color/phoenix_orange_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/phoenix_orange</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/phoenix_orange_dark</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="toolbarStyle">@style/Widget.NavettePhoenix.Toolbar</item>
    </style>

    <style name="Theme.NavettePhoenix.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/phoenix_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/phoenix_bg</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="toolbarStyle">@style/Widget.NavettePhoenix.Toolbar</item>
    </style>

    <style name="Widget.NavettePhoenix.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:titleTextColor">@color/text_primary</item>
        <item name="android:subtitleTextColor">@color/text_secondary</item>
    </style>
</resources>
