<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/image_logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/content_logo"
            android:src="@drawable/ic_phoenix"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_tagline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/app_tagline"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/image_logo" />

        <LinearLayout
            android:id="@+id/container_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_tagline">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_tad"
                style="@style/Widget.NavettePhoenix.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cta_tad" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_devis"
                style="@style/Widget.NavettePhoenix.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cta_devis" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_infos"
                style="@style/Widget.NavettePhoenix.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cta_infos" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_zone_gares"
                style="@style/Widget.NavettePhoenix.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cta_zone_gares" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_contact"
                style="@style/Widget.NavettePhoenix.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cta_contact" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_privacy"
                style="@style/Widget.NavettePhoenix.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cta_privacy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_sos"
                style="@style/Widget.NavettePhoenix.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cta_sos" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
